fix-revalidate.js
fix_newlines.js
recover_files.js
check-exports.js

# OS-level AI-OS config (per-developer, not committed)
.sw.js*
sw.js.bak
public/sw.js.bak

# AI-OS generated files (eval results, history)
evals/results.json
memory/evals-history.md
