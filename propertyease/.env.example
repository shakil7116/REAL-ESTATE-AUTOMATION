# Environment Variables for PropertyEase
# Copy this file to .env.local and fill in your values

# Database
# Local Postgres example — replace USER and PASSWORD with your values.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/propertyease"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-this"

# AI (for chatbot, ad generation, lead scoring)
OPENAI_API_KEY=""

# Meta (Facebook/Instagram) Ads
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""

# Email (Resend - free tier: 100 emails/day)
RESEND_API_KEY=""

# File Upload (Cloudinary - free: 10GB)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# App Info
NEXT_PUBLIC_APP_NAME="PropertyEase"
# Default country for new users. Codes: QA (Qatar), AE (UAE), SA, KW, BH, OM.
# See src/context/CountryContext.tsx for the full list.
NEXT_PUBLIC_DEFAULT_COUNTRY="QA"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Monitoring (Sentry — optional, used for error tracking in prod)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG="propertyease"
SENTRY_PROJECT="propertyease-web"
