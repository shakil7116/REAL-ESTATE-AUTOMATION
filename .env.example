# ─────────────────────────────────────────────────────────────────
# PropertyEase — AI-OS Root Environment Variables
# These are loaded by the AI-OS itself (eval harness, MCP servers).
# Per-app envs (Next.js, Expo) live in:
#   propertyease/.env.example
#   propertyease-mobile/.env.example (to be created)
# ─────────────────────────────────────────────────────────────────

# ── LLM engine (the AI-OS reads this to pick the active model) ────
# Default model for all LLM calls. Engine-agnostic — change freely.
ANTHROPIC_DEFAULT_OPUS_MODEL="minimax-m3-free"
ANTHROPIC_DEFAULT_SONNET_MODEL="minimax-m3-free"
ANTHROPIC_DEFAULT_HAIKU_MODEL="minimax-m3-free"

# ── Engine proxy (only if you route through a third party) ───────
# Leave empty to use the upstream provider directly.
ANTHROPIC_BASE_URL=""
ANTHROPIC_AUTH_TOKEN=""

# ── Eval harness ─────────────────────────────────────────────────
# Set to 1 to run evals in stub mode (no real LLM call, for CI)
PE_EVAL_STUB="0"

# ── MCP tokens (consumed by .mcp.json) ────────────────────────────
# GitHub (for issue/PR automation)
GITHUB_TOKEN=""

# Vercel (for deploy logs + env management)
VERCEL_TOKEN=""

# Linear (for backlog management)
LINEAR_API_KEY=""

# ── OpenAI (used by PropertyEase Copilot in production) ──────────
OPENAI_API_KEY=""

# ── Resend (transactional email) ──────────────────────────────────
RESEND_API_KEY=""

# ── Supabase (consumed by the Supabase MCP server) ───────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── App info ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="PropertyEase"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_CURRENCY="QAR"
NEXT_PUBLIC_DOMAIN="propertyease.qa"
